{
  "appId": "ru.kvnrb.app",
  "appName": "КВН Уфа",
  "webDir": "www",
  "server": {
    "url": "https://kvnrb.ru",
    "androidScheme": "https",
    "allowNavigation": [
      "kvnrb.ru",
      "*.kvnrb.ru"
    ]
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 0,
      "backgroundColor": "#ffffff",
      "androidSplashResourceName": "splash",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "LIGHT",
      "backgroundColor": "#5B17D0"
    },
    "PushNotifications": {
      "presentationOptions": [
        "badge",
        "sound",
        "alert"
      ]
    }
  }
}
